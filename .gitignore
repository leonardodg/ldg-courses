# This file specifies intentionally untracked files that all Moodle git
# repositories should ignore. It is recommended not to modify this file in your
# local clone. Instead, use .git/info/exclude and add new records there as
# needed.
#
# Example: if you deploy a contributed plugin mod/foobar into your site, put
# the following line into .git/info/exclude file in your Moodle clone:
# /mod/foobar/
#
# See gitignore(5) man page for more details
#

# Swap files (vim)
[._]*.s[a-v][a-z]
[._]*.sw[a-p]
[._]s[a-rt-v][a-z]
[._]ss[a-gi-z]
[._]sw[a-p]
# Temporary files including undo
*~
#
/config.php
# Ajuste local da maquina. Nunca versionado: e por definicao o que vale
# numa maquina so, e costuma conter credencial de teste ou chave de debug.
/config-local.php
/tags
/TAGS
/cscope.*
/.patches/
/.idea/
.phpstorm.*
!/.phpstorm.meta.php/
/.phpstorm.meta.php/*
!/.phpstorm.meta.php/di.php
/nbproject/
CVS
.DS_Store
/.settings/
/.project
/.buildpath
/.cache
.phpunit.result.cache
phpunit.xml
# Composer support. Do not ignore composer.json, or composer.lock. These should be shipped by us.
composer.phar
/vendor/
/behat.yml
*/yui/build/*/*-coverage.js
/public/lib/yuilib/*/build/*/*-coverage.js
# lib/yuilib/version/module/module-coverage.js
/public/lib/yuilib/*/*/*-coverage.js
atlassian-ide-plugin.xml
/node_modules/
/.vscode/
moodle-plugin-ci.phar
.eslintignore
.stylelintignore
/jsdoc
/public/admin/tool/componentlibrary/docs
/public/admin/tool/componentlibrary/hugo/site/data/my-index.json
.hugo_build.lock
phpcs.xml
jsconfig.json
UPGRADING-CURRENT.md
.phpunit.cache
tsconfig.aliases.json

# Documentacao CONFIDENCIAL de negocio: planos, margem, custo, comparacao com
# concorrente. O remote origin e um repositorio PUBLICO, e o deploy faz rsync de
# docs/ para a VPS - um "git add ." aqui publicaria calculo de lucro.
#
# O que pode entrar em documento versionado e so o que a landing EXIBE: preco,
# percentual de comissao, resolucao por faixa. Margem e custo, nunca.
#
# Ignorado aqui, no .gitignore versionado, e nao em .git/info/exclude, de
# proposito: um exclude invisivel some num clone novo e ninguem revisa.
/docs/private/

# Segredos e certificados locais de dev - nunca versionar.
# Os arquivos .example ao lado servem de template.
.devcontainer/secrets/
.devcontainer/certs/*.key
.devcontainer/certs/*.crt
!.devcontainer/certs/*.example

.devcontainer/env/db.env
.devcontainer/env/dev.env
.devcontainer/env/prod.env

# .env da raiz: variaveis de interpolacao do compose, com caminhos da maquina.
/.env

# Symlink para o /.env acima, criado pelo "cf".
# A extensao Dev Containers monta o proprio "docker compose -f ..." sem passar
# --env-file, e o compose entao procura o .env no diretorio do PRIMEIRO arquivo
# compose - este aqui - em vez da raiz do repo. Sem o link, o Reopen in Container
# falha com "required variable DB_HOST_DATA is missing a value".
.devcontainer/compose/.env

# Dataroot do PHPUnit, por worktree (montado por compose/local-dev.yml).
/phpu_moodledata/

# Mapa de dominios por vendedor, gerado pelo local_marketplace em runtime.
.devcontainer/marketplace_domains.php

# Grafo de conhecimento gerado pelo graphify. Regeneravel, ~1 MB.
/graphify-out/

# Bytecode do Python, gerado pelos scripts de docs/diagram/gerar/.
__pycache__/
*.pyc
