{
  "version": "1.0",
  "project": "LDG Courses - D5 Etapa Documento",
  "description": "Formulário CNPJ/CPF com máscara e validação",
  "theme": {
    "name": "LDG Studio (Boost + Bootstrap 5)",
    "tokens": {
      "dark": { "--ldg-bg": "#121212", "--ldg-surface": "#1e1e1e", "--ldg-border": "#3a3b3c", "--ldg-text": "#ffffff", "--ldg-text-muted": "#b0b3b8", "--ldg-accent": "#4b8eff" },
      "light": { "--ldg-bg": "#f4f6fa", "--ldg-surface": "#ffffff", "--ldg-border": "#d5dce6", "--ldg-text": "#0e192b", "--ldg-text-muted": "#5a6b82", "--ldg-accent": "#007aff" }
    }
  },
  "screens": [{
    "id": "D5",
    "name": "Etapa: Documento CNPJ/CPF",
    "viewport": { "width": 412, "height": 892 },
    "viewportDesktop": { "width": 1280, "height": 800 },
    "template": "block_marketplace/step_document",
    "context": {
      "progress": { "current": 3, "total": 6 },
      "documentTypes": [
        { "value": "cnpj", "label": "CNPJ (Pessoa Jurídica)", "placeholder": "00.000.000/0000-00", "mask": "cnpj" },
        { "value": "cpf", "label": "CPF (Pessoa Física)", "placeholder": "000.000.000-00", "mask": "cpf", "note": "Pessoa física pode vender cursos normalmente" }
      ],
      "formFields": [
        { "type": "text", "name": "document", "label": "Número do documento", "placeholder": "00.000.000/0000-00", "required": true, "validation": "cnpj|cpf" },
        { "type": "text", "name": "companyName", "label": "Razão social / Nome completo", "required": true },
        { "type": "text", "name": "tradeName", "label": "Nome fantasia (opcional)", "required": false },
        { "type": "select", "name": "country", "label": "País", "options": [{ "value": "BR", "label": "Brasil" }], "required": true }
      ],
      "cta": { "label": "Salvar e continuar", "variant": "primary" },
      "alert": { "variant": "info", "text": "O documento será validado automaticamente. Para CNPJ, consultamos a Receita Federal. Para CPF, validamos o dígito verificador." }
    }
  }]
}