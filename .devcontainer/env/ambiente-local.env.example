# Segredos do ambiente local espelho da producao.
#
# COPIE para .devcontainer/secrets/ambiente-local.env (gitignored) e preencha:
#
#   cp .devcontainer/env/ambiente-local.env.example .devcontainer/secrets/ambiente-local.env
#
# Lido por .devcontainer/devtools/ambiente-local.php. O repositorio e publico:
# nada daqui pode ir para o script. Guia: docs/dev/ambiente-local.md.

# Acessos de teste. O aluno nasce matriculado num curso restaurado.
ADMIN_PASSWORD=
STUDENT_USERNAME=aluno
STUDENT_PASSWORD=
STUDENT_EMAIL=aluno@example.com
# Senha do vendedor1 criado pelo seed_demo.php (--password). So registro.
SELLER_PASSWORD=

# SMTP: os MESMOS da producao (Gmail, senha de app).
SMTP_USER=
SMTP_PASS=

# Mercado Pago: a MESMA aplicacao da producao, com a chave publica de TESTE.
# O vendedor de teste vincula pelo OAuth, no navegador, pelo endereco do tunel.
MP_CLIENTID=
MP_CLIENTSECRET=
MP_PUBLICKEYTEST=
# Assinatura secreta do webhook de TESTE (painel do MP -> Webhooks). Vazio
# desliga a conferencia de assinatura, como esta hoje em producao.
MP_WEBHOOKSECRET=
