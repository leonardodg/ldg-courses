# Copie para dev.env e ajuste. dev.env e gitignored (pode conter dados do seu host).

# Caminhos no HOST
MOODLE_HOST_WWWROOT=/caminho/para/gitworktree-bare-moodle/feature-infra-vps
MOODLE_HOST_DATA=/caminho/para/moodledata

# Caminhos DENTRO do container.
# WWWROOT e a raiz do repo (config.php mora aqui, fora do webroot).
# DOCUMENT_ROOT e o que o Apache serve: public/, conforme o layout do Moodle 5.x.
MOODLE_DOCKER_WWWROOT=/var/www/html
MOODLE_DOCKER_DATA=/var/www/moodledata
APACHE_DOCUMENT_ROOT=/var/www/html/public

# Moodle 5.2 exige PHP >= 8.3.0 e MariaDB >= 10.11.
MOODLE_DOCKER_PHP_VERSION=8.4
MOODLE_DOCKER_BROWSER=firefox
MOODLE_DOCKER_DB_VERSION=mariadb:11.4

MOODLE_ADMIN=admin

# Precisa bater com o CN do certificado em .devcontainer/certs/.
# O entrypoint gera um self-signed automaticamente se o cert nao existir.
MOODLE_URL=https://courses.leodg.dev

# Imagem publicada no Docker Hub.
MOODLE_IMAGE=leodg/ldg-courses:development

# Debug. Fica aqui, e nao no compose, porque o dev.yml tambem sobe na VPS.
MOODLE_DEBUG=DEVELOPER
MOODLE_DEBUG_DISPLAY=1
